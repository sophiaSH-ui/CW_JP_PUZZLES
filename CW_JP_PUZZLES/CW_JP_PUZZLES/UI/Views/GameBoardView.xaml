<UserControl x:Class="CW_JP_PUZZLES.UI.Views.GameBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CW_JP_PUZZLES.UI.ViewModels"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="BACK" Command="{Binding BackCommand}" Style="{StaticResource ModernButton}" Width="110" Height="44" FontSize="15" Margin="0 0 12 0"/>
                <Button Content="⚙" Command="{Binding ResetCommand}" Style="{StaticResource ModernButton}" Width="44" Height="44" FontSize="18" Padding="0" Margin="0 0 12 0"/>
                <Button Content="⟳" Command="{Binding ResetCommand}" Style="{StaticResource ModernButton}" Width="44" Height="44" FontSize="20" Padding="0" Margin="0 0 12 0"/>
                <Button Content="NEW GAME" Command="{Binding NewGameCommand}" Style="{StaticResource ModernButton}" Width="140" Height="44" FontSize="15"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0 25 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0 0 30 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Background="Black" Margin="8 8 -8 -8"/>
                        <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Padding="25">
                            <StackPanel>
                                <TextBlock Text="{Binding GameName}" Foreground="White" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" Margin="0 0 0 15"/>
                                <TextBlock Text="Place elements carefully following the unique constraints of the puzzle rules. Ensure complete logic synchronization across rows and structural boundaries." 
                                           Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Opacity="0.95"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0 20 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0 0 10 0">
                            <Border Background="Black" Margin="6 6 -6 -6"/>
                            <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Padding="12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="MOVE" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center" Opacity="0.9"/>
                                    <TextBlock Text="{Binding MoveCount}" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0 4 0 0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1" Margin="10 0 0 0">
                            <Border Background="Black" Margin="6 6 -6 -6"/>
                            <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Padding="12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="TIME" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center" Opacity="0.9"/>
                                    <TextBlock Text="{Binding TimeDisplay}" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0 4 0 0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1">
                    <Border Background="Black" Margin="10 10 -10 -10"/>
                    <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Padding="20">
                        <Viewbox Stretch="Uniform">
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="{Binding GridSize}" Columns="{Binding GridSize}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CellViewModel}">
                                        <Button Command="{Binding LeftClickCommand}" Margin="4" Focusable="False">
                                            <Button.InputBindings>
                                                <MouseBinding MouseAction="RightClick" Command="{Binding RightClickCommand}"/>
                                            </Button.InputBindings>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border Background="Black" Margin="4 4 -4 -4"/>
                                                        <Border x:Name="CellContainer" Background="#C8CDD8" BorderBrush="Black" BorderThickness="4" Width="72" Height="72">
                                                            <Grid>
                                                                <Border Background="{Binding RegionColor}" Opacity="0.5" IsHitTestVisible="False"/>
                                                                <Ellipse x:Name="BulbNode" Width="36" Height="36" Fill="#FFDF6D" Stroke="Black" StrokeThickness="3" Visibility="Collapsed"/>
                                                                <Ellipse x:Name="HitoriRing" Width="54" Height="54" Stroke="Black" StrokeThickness="4" Fill="Transparent" Visibility="Collapsed"/>
                                                                <TextBlock x:Name="ValueLabel" Text="{Binding DisplayValue}" Foreground="Black" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsIlluminated}" Value="True">
                                                            <Setter TargetName="CellContainer" Property="Background" Value="{StaticResource BrushAccentLine}"/>
                                                            <Setter TargetName="ValueLabel" Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasBulb}" Value="True">
                                                            <Setter TargetName="BulbNode" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWall}" Value="True">
                                                            <Setter TargetName="CellContainer" Property="Background" Value="{StaticResource BrushBgDeep}"/>
                                                            <Setter TargetName="ValueLabel" Property="Text" Value="{Binding WallNumberText}"/>
                                                            <Setter TargetName="ValueLabel" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBlackened}" Value="True">
                                                            <Setter TargetName="CellContainer" Property="Background" Value="{StaticResource BrushBgDeep}"/>
                                                            <Setter TargetName="ValueLabel" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCircled}" Value="True">
                                                            <Setter TargetName="HitoriRing" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter TargetName="ValueLabel" Property="Foreground" Value="#D94343"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasBulb}" Value="True"/>
                                                                <Condition Binding="{Binding HasError}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="BulbNode" Property="Fill" Value="#D94343"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="CellContainer" Property="Margin" Value="4 4 -4 -4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>