<UserControl x:Class="CW_JP_PUZZLES.UI.Views.GameBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CW_JP_PUZZLES.UI.ViewModels"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="BACK" Command="{Binding BackCommand}" Style="{StaticResource ModernButton}" Width="110" Height="44" FontSize="15" Margin="0 0 12 0"/>
                <Button Content="⚙" Command="{Binding ResetCommand}" Style="{StaticResource ModernButton}" Width="44" Height="44" FontSize="18" Padding="0" Margin="0 0 12 0"/>
                <Button Content="⟳" Command="{Binding ResetCommand}" Style="{StaticResource ModernButton}" Width="44" Height="44" FontSize="20" Padding="0" Margin="0 0 12 0"/>
                <Button Content="NEW GAME" Command="{Binding NewGameCommand}" Style="{StaticResource ModernButton}" Width="140" Height="44" FontSize="15"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0 25 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0 0 30 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushElementBg}" CornerRadius="20" Padding="25">
                        <StackPanel>
                            <TextBlock Text="{Binding GameName}" Foreground="{StaticResource BrushWhite}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 15"/>
                            <TextBlock Text="Place elements carefully following the unique constraints of the puzzle rules. Ensure complete logic synchronization across rows and structural boundaries." 
                                       Foreground="{StaticResource BrushWhite}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Opacity="0.95"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0 20 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BrushElementBg}" CornerRadius="18" Margin="0 0 10 0" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="MOVE" Foreground="{StaticResource BrushWhite}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="{Binding MoveCount}" Foreground="{StaticResource BrushWhite}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource BrushElementBg}" CornerRadius="18" Margin="10 0 0 0" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TIME" Foreground="{StaticResource BrushWhite}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="{Binding TimeDisplay}" Foreground="{StaticResource BrushWhite}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource BrushElementBg}" CornerRadius="20" Padding="20">
                    <Viewbox Stretch="Uniform">
                        <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding GridSize}" Columns="{Binding GridSize}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CellViewModel}">
                                    <Button Command="{Binding LeftClickCommand}" Margin="3" Focusable="False">
                                        <Button.InputBindings>
                                            <MouseBinding MouseAction="RightClick" Command="{Binding RightClickCommand}"/>
                                        </Button.InputBindings>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CellContainer" Background="{StaticResource BrushCardBg}" CornerRadius="12" Width="72" Height="72">
                                                    <Grid>
                                                        <Border Background="{Binding RegionColor}" CornerRadius="12" Opacity="0.5" IsHitTestVisible="False"/>
                                                        <Ellipse x:Name="BulbNode" Width="36" Height="36" Fill="#FFDF6D" Visibility="Collapsed"/>
                                                        <Ellipse x:Name="HitoriRing" Width="54" Height="54" Stroke="#FFDF6D" StrokeThickness="4" Fill="Transparent" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="ValueLabel" Text="{Binding DisplayValue}" Foreground="#1A2233" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsIlluminated}" Value="True">
                                                        <Setter TargetName="CellContainer" Property="Background" Value="#BDC9D8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasBulb}" Value="True">
                                                        <Setter TargetName="BulbNode" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWall}" Value="True">
                                                        <Setter TargetName="CellContainer" Property="Background" Value="#2A2F3D"/>
                                                        <Setter TargetName="ValueLabel" Property="Text" Value="{Binding WallNumberText}"/>
                                                        <Setter TargetName="ValueLabel" Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBlackened}" Value="True">
                                                        <Setter TargetName="CellContainer" Property="Background" Value="#2A2F3D"/>
                                                        <Setter TargetName="ValueLabel" Property="Foreground" Value="#5C657A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCircled}" Value="True">
                                                        <Setter TargetName="HitoriRing" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter TargetName="ValueLabel" Property="Foreground" Value="#D94343"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasBulb}" Value="True"/>
                                                            <Condition Binding="{Binding HasError}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="BulbNode" Property="Fill" Value="#D94343"/>
                                                    </MultiDataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CellContainer" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>