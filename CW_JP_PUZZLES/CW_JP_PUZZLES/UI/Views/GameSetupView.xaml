<UserControl x:Class="CW_JP_PUZZLES.UI.Views.GameSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button Content="BACK" Command="{Binding BackCommand}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Width="120" Height="48" FontSize="16"/>
                <Button Content="⚙" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Width="48" Height="48" FontSize="22" Padding="0"/>
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="40 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 60 0">
                    <TextBlock Text="GAME" Foreground="{StaticResource BrushWhite}" FontSize="20" FontWeight="Bold" Margin="10 0 0 8"/>
                    <Border Background="{StaticResource BrushElementBg}" CornerRadius="20" Height="76" Margin="0 0 0 30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="&lt;" Style="{StaticResource ModernButton}" Width="56" Background="Transparent" Command="{Binding PrevGameCommand}"/>
                            <TextBlock Grid.Column="1" Text="{Binding GameName}" Foreground="{StaticResource BrushWhite}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="&gt;" Style="{StaticResource ModernButton}" Width="56" Background="Transparent" Command="{Binding NextGameCommand}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="DIFFICULTY" Foreground="{StaticResource BrushWhite}" FontSize="20" FontWeight="Bold" Margin="10 0 0 8"/>
                    <Border Background="{StaticResource BrushElementBg}" CornerRadius="20" Height="76">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="&lt;" Style="{StaticResource ModernButton}" Width="56" Background="Transparent" Command="{Binding ToggleDifficultyCommand}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedDifficultyText}" Foreground="{StaticResource BrushWhite}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="&gt;" Style="{StaticResource ModernButton}" Width="56" Background="Transparent" Command="{Binding ToggleDifficultyCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding StartCommand}" Style="{StaticResource PlaySetupButton}" Width="260" Height="260">
                    <Path Data="M 0,0 L 60,35 L 0,70 Z" Fill="Transparent" Stroke="{StaticResource BrushWhite}" StrokeThickness="6" Stretch="Fill" Width="70" Height="70" Margin="15 0 0 0"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>