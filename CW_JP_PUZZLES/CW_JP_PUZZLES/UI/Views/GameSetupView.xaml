<UserControl x:Class="CW_JP_PUZZLES.UI.Views.GameSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button Content="BACK" Command="{Binding BackCommand}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Width="120" Height="48" FontSize="16"/>
                <Button Content="⚙" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Width="48" Height="48" FontSize="22" Padding="0"/>
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="40 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 60 0">
                    <TextBlock Text="GAME" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10 0 0 8"/>

                    <Grid Margin="0 0 0 30">
                        <Border Background="Black" Margin="6 6 -6 -6"/>
                        <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Height="76">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="&lt;" Style="{StaticResource ModernButton}" Width="56" Height="56" Margin="10 0 0 0" Padding="0" Command="{Binding PrevGameCommand}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayGameName}" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="&gt;" Style="{StaticResource ModernButton}" Width="56" Height="56" Margin="0 0 10 0" Padding="0" Command="{Binding NextGameCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="DIFFICULTY" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10 0 0 8"/>

                    <Grid>
                        <Border Background="Black" Margin="6 6 -6 -6"/>
                        <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Height="76">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="&lt;" Style="{StaticResource ModernButton}" Width="56" Height="56" Margin="10 0 0 0" Padding="0" Command="{Binding ToggleDifficultyCommand}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDifficultyText}" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="&gt;" Style="{StaticResource ModernButton}" Width="56" Height="56" Margin="0 0 10 0" Padding="0" Command="{Binding ToggleDifficultyCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding StartCommand}" Style="{StaticResource PlaySetupButton}" Width="260" Height="260">
                    <Path Data="M 0,0 L 70,40 L 0,80 Z" Fill="White" Stroke="Black" StrokeThickness="6" Stretch="Fill" Width="80" Height="80" Margin="15 0 0 0"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>