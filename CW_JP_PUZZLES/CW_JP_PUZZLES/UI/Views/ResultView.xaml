<UserControl x:Class="CW_JP_PUZZLES.UI.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="45">
            <Border Background="{StaticResource BrushElementBg}" CornerRadius="20" Padding="25" Margin="0 0 0 40">
                <TextBlock Text="YOU WIN!" Foreground="{StaticResource BrushWhite}" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <Border Background="{StaticResource BrushElementBg}" CornerRadius="18" Padding="24 16" Margin="0 0 0 16">
                <Grid>
                    <TextBlock Text="MOVE" Foreground="{StaticResource BrushWhite}" FontSize="22" FontWeight="Bold" Opacity="0.7"/>
                    <TextBlock Text="{Binding MoveDisplay}" Foreground="{StaticResource BrushWhite}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Border Background="{StaticResource BrushElementBg}" CornerRadius="18" Padding="24 16" Margin="0 0 0 45">
                <Grid>
                    <TextBlock Text="TIME" Foreground="{StaticResource BrushWhite}" FontSize="22" FontWeight="Bold" Opacity="0.7"/>
                    <TextBlock Text="{Binding TimeDisplay}" Foreground="{StaticResource BrushWhite}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding MenuCommand}" Content="BACK TO MENU" Style="{StaticResource ModernButton}" Height="72" Width="210" FontSize="16" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Command="{Binding PlayAgainCommand}" Content="NEW GAME" Style="{StaticResource ModernButton}" Height="72" Width="210" FontSize="16" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>