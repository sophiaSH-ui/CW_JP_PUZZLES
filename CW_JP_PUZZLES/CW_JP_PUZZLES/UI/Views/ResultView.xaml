<UserControl x:Class="CW_JP_PUZZLES.UI.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="45">
            <Grid Margin="0 0 0 40">
                <Border Background="Black" Margin="8 8 -8 -8"/>
                <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Padding="25">
                    <TextBlock Text="YOU WIN!" Foreground="White" FontSize="46" FontWeight="Black" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <Grid Margin="0 0 0 16">
                <Border Background="Black" Margin="6 6 -6 -6"/>
                <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Padding="24 16">
                    <Grid>
                        <TextBlock Text="MOVE" Foreground="White" FontSize="22" FontWeight="Black"/>
                        <TextBlock Text="{Binding MoveDisplay}" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0 0 0 45">
                <Border Background="Black" Margin="6 6 -6 -6"/>
                <Border Background="{StaticResource BrushElementBg}" BorderBrush="Black" BorderThickness="4" Padding="24 16">
                    <Grid>
                        <TextBlock Text="TIME" Foreground="White" FontSize="22" FontWeight="Black"/>
                        <TextBlock Text="{Binding TimeDisplay}" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding MenuCommand}" Content="BACK TO MENU" Style="{StaticResource ModernButton}" Height="72" Width="210" FontSize="16" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Command="{Binding PlayAgainCommand}" Content="NEW GAME" Style="{StaticResource ModernButton}" Height="72" Width="210" FontSize="16" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>