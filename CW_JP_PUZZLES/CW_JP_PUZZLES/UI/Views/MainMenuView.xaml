<UserControl x:Class="CW_JP_PUZZLES.UI.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <Button Command="{Binding SelectGameCommand}" CommandParameter="Akari" Style="{StaticResource ModernButton}" Height="120" Margin="0 0 0 25">
                    <Border BorderBrush="{StaticResource BrushAccentLine}" BorderThickness="0 0 0 4" Padding="0 0 0 8">
                        <TextBlock Text="PLAY" FontSize="56" FontWeight="Bold"/>
                    </Border>
                </Button>

                <Button Content="SETTINGS" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ModernButton}" Height="64" Margin="0 0 0 45" FontSize="24"/>

                <Button Content="EXIT" Command="{Binding ExitCommand}" Style="{StaticResource ModernButton}" Background="{StaticResource BrushDestructive}" Height="64" Width="240" FontSize="24"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>