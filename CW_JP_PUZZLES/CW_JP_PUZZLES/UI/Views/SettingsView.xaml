<UserControl x:Class="CW_JP_PUZZLES.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource ModernWindowCard}">
        <Grid Margin="40">
            <Button Content="BACK" Command="{Binding BackCommand}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120" Height="48" FontSize="16"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="60 0" Width="720">
                <TextBlock Text="🎵 MUSIC" Foreground="White" FontSize="32" FontWeight="Black" Margin="0 0 0 15"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding MusicVolume}" Style="{StaticResource ModernSlider}" Margin="0 0 0 60"/>

                <TextBlock Text="🔊 SOUND FX" Foreground="White" FontSize="32" FontWeight="Black" Margin="0 0 0 15"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding SfxVolume}" Style="{StaticResource ModernSlider}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>