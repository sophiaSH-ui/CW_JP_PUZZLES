<Window x:Class="CW_JP_PUZZLES.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CW_JP_PUZZLES.UI.ViewModels"
        xmlns:views="clr-namespace:CW_JP_PUZZLES.UI.Views"
        Title="JAPANESE PUZZLES"
        Width="1024" Height="680"
        MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <views:MainMenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameSetupViewModel}">
            <views:GameSetupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:GameBoardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultViewModel}">
            <views:ResultView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform" Margin="10">
        <Grid Width="964" Height="620">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Viewbox>
</Window>