<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PixelColors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorBgPanel}"/>
    <SolidColorBrush x:Key="BrushElementBg" Color="{StaticResource ColorPurple}"/>
    <SolidColorBrush x:Key="BrushAccentLine" Color="{StaticResource ColorCream}"/>
    <SolidColorBrush x:Key="BrushWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushBlack" Color="#000000"/>
    <SolidColorBrush x:Key="BrushDestructive" Color="{StaticResource ColorPurple}"/>

    <DrawingBrush x:Key="BrutalTexture" Viewport="0,0,4,4" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushCardBg}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1A000000">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,2,2"/>
                            <RectangleGeometry Rect="2,2,2,2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="BrutalButtonTexture" Viewport="0,0,4,4" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushElementBg}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#1A000000">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,2,2"/>
                            <RectangleGeometry Rect="2,2,2,2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="ModernWindowCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrutalTexture}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBlack}"/>
        <Setter Property="BorderThickness" Value="4"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="0" Direction="315" ShadowDepth="12" Opacity="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrutalButtonTexture}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Padding" Value="20 10"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="Black" Margin="6 6 -6 -6" BorderThickness="0" CornerRadius="0"/>
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="Black" BorderThickness="4" CornerRadius="0">
                            <ContentPresenter x:Name="BtnContent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource BrushAccentLine}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushBgDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Margin" Value="6 6 -6 -6"/>
                            <Setter TargetName="BtnBorder" Property="Background" Value="Black"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaySetupButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Background" Value="{StaticResource BrushAccentLine}"/>
    </Style>

    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Margin="0 10 10 10">
                        <Border Background="Black" Height="32" Margin="6 6 -6 -6"/>
                        <Border x:Name="TrackBackground" Background="{StaticResource BrushBgDeep}" BorderBrush="Black" BorderThickness="4" Height="32">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{StaticResource BrushElementBg}" Height="24" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="40">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border Background="Black" Margin="4 4 -4 -4"/>
                                                    <Border Background="White" BorderBrush="Black" BorderThickness="4"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>